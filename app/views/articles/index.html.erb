<h1>投稿一覧</h1>

<% if notice %>
  <p class="success-message"><%= notice %></p>
<% end %>

<% if alert %>
  <p class="error-message"><%= alert %></p>
<% end %>

<%= link_to "新規投稿", new_article_path %>

<% @articles.each do |article| %>
  <div class="article-item">
    <h2><%= link_to article.title, article_path(article) %></h2>
    <p><%= article.content %></p>
  </div>
<% end %>